SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020102> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000056> <https://openenergyplatform.org/ontology/oeo/OEO_00020003>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020102> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000056> <https://openenergyplatform.org/ontology/oeo/OEO_00020104>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020102> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00010235> <https://openenergyplatform.org/ontology/oeo/OEO_00010114>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00020103> (energy transfer)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00020103> "Energy transfer is an energy transformation in form of a spatial transmission, that does not change the types of energies, apart from losses, e.g. waste heat.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00020103> "energy transfer"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020103> <https://openenergyplatform.org/ontology/oeo/OEO_00020003>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00020104> (outage)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00020104> "An outage is a process during which an artificial object cannot perform or operate.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00020104> "outage"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020104> <http://purl.obolibrary.org/obo/BFO_0000015>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020104> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <https://openenergyplatform.org/ontology/oeo/OEO_00020102>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00020107> (curtailment)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00020107> "Curtailment is a process in which a power generating unit is forced to reduce its output, in order to balance energy supply and demand or due to transmission constraints.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00020107> "curtailment"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020107> <http://purl.obolibrary.org/obo/BFO_0000015>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020107> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <https://openenergyplatform.org/ontology/oeo/OEO_00000334>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00020121> (resolution)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00020121> "Resolution is a quality of a dataset that indicates the level of detail of the data.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00020121> "resolution"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020121> <http://purl.obolibrary.org/obo/BFO_0000019>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020121> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <http://purl.obolibrary.org/obo/IAO_0000100>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00020122> (temporal resolution)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00020122> "Temporal resolution is the resolution of a time series that indicates time-dependent the level of detail.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00020122> "temporal resolution"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020122> <https://openenergyplatform.org/ontology/oeo/OEO_00020121>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020122> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <https://openenergyplatform.org/ontology/oeo/OEO_00030034>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00020136> (space requirement)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00020136> "A space requirement is a two-dimensional spatial region that covers the area needed by an object or object aggregate.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00020136> "space requirement"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020136> <http://purl.obolibrary.org/obo/BFO_0000009>)

