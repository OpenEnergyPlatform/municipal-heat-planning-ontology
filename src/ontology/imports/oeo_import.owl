SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240014> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00000500> <https://openenergyplatform.org/ontology/oeo/OEO_00240013>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00240019> (energy consumption value)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00240019> "An energy consumption value is an energy amount value that measures the energy consumption over a time span."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00240019> "energy consumption value"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240019> <https://openenergyplatform.org/ontology/oeo/OEO_00050019>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240019> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000136> <https://openenergyplatform.org/ontology/oeo/OEO_00010210>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240019> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000136> <https://openenergyplatform.org/ontology/oeo/OEO_00030035>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00240026> (manufactured material)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00240026> "A manufactured material is a portion of matter that is the physical output of a manufacturing process and that has a good role."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00240026> "manufactured material"@en)
EquivalentClasses(<https://openenergyplatform.org/ontology/oeo/OEO_00240026> ObjectIntersectionOf(<https://openenergyplatform.org/ontology/oeo/OEO_00000331> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <https://openenergyplatform.org/ontology/oeo/OEO_00010117>) ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00240025> <https://openenergyplatform.org/ontology/oeo/OEO_00050000>)))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240026> <https://openenergyplatform.org/ontology/oeo/OEO_00000331>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00240027> (chemical substance)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00240027> "A chemical substance is a portion of matter of constant composition and that is neither a metal or mineral. It is composed of molecular entities of the same type or of different types that is used in or produced by a chemical reaction involving changes to atoms or molecules. It is the physical output of an industrial process and has a commodity role."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00240027> "chemical substance"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240027> <https://openenergyplatform.org/ontology/oeo/OEO_00000331>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240027> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <https://openenergyplatform.org/ontology/oeo/OEO_00040011>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240027> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00240025> <https://openenergyplatform.org/ontology/oeo/OEO_00050000>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240027> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00240025> <https://openenergyplatform.org/ontology/oeo/OEO_00140033>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00240029> (cement)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00240029> "Cement is a portion of matter that is made from limestone and clay; other elements may be present. It is used as a building material to set as a solid mass or is used as an ingredient in making mortar or concrete. It has a solid normal state of matter. It is the physical output of an industrial process and has a commodity role."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00240029> "cement"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240029> <https://openenergyplatform.org/ontology/oeo/OEO_00000331>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240029> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <https://openenergyplatform.org/ontology/oeo/OEO_00040011>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240029> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00240025> <https://openenergyplatform.org/ontology/oeo/OEO_00050000>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240029> ObjectHasValue(<https://openenergyplatform.org/ontology/oeo/OEO_00000529> <https://openenergyplatform.org/ontology/oeo/OEO_00000390>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00240030> (mineral)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00240030> "A mineral is a portion of matter that is normally crystalline formed."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00240030> "mineral"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240030> <https://openenergyplatform.org/ontology/oeo/OEO_00000331>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00240032> (metal)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00240032> "A metal is a portion of matter consisting of an atom of an element that exhibits typical metallic properties, being typically shiny, with high electrical and thermal conductivity."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00240032> "metal"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240032> <https://openenergyplatform.org/ontology/oeo/OEO_00000331>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00240034> (steel)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00240034> "Steel is a metal that consists mainly of iron and up to 2.14 % of carbon; other elements may be present. It has a solid normal state of matter. It has a solid normal state of matter. It is the physical output of an industrial process and has a commodity role."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00240034> "steel"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240034> <https://openenergyplatform.org/ontology/oeo/OEO_00240032>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240034> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <https://openenergyplatform.org/ontology/oeo/OEO_00040011>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240034> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00240025> <https://openenergyplatform.org/ontology/oeo/OEO_00050000>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00240034> ObjectHasValue(<https://openenergyplatform.org/ontology/oeo/OEO_00000529> <https://openenergyplatform.org/ontology/oeo/OEO_00000390>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00260007> (CO2 emission)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00260007> "A CO2 emission is an emission that releases carbon dioxide."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00260007> "CO2 emission"@en)
EquivalentClasses(<https://openenergyplatform.org/ontology/oeo/OEO_00260007> ObjectIntersectionOf(<https://openenergyplatform.org/ontology/oeo/OEO_00000147> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <https://openenergyplatform.org/ontology/oeo/OEO_00000006>)))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00260007> <https://openenergyplatform.org/ontology/oeo/OEO_00000147>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00320000> (transport performance value)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00320000> "A transport performance value is a quantity value that indicates the performance of a transport process in terms of its mileage and amount of transported people and/or goods."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00320000> "transport performance value"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00320000> <https://openenergyplatform.org/ontology/oeo/OEO_00000350>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00320000> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00040010> <https://openenergyplatform.org/ontology/oeo/OEO_00320001>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00320001> (transport performance unit)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00320001> "A transport performance unit is a unit of measurement for the accumulated transport distance of a number of people and/or amount of goods.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00320001> "transport performance unit"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00320001> <https://openenergyplatform.org/ontology/oeo/OEO_00010490>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00320041> (vehicle operational mode)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00320041> "A vehicle operational mode is a realizable entity that determines how a vehicle is operating."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00320041> "vehicle operational mode"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00320041> <http://purl.obolibrary.org/obo/BFO_0000017>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00320041> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <https://openenergyplatform.org/ontology/oeo/OEO_00010023>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00340062> (quantity)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00340062> "A quantity is a quality of a material entity where the magnitude  of the quality can be quantified via a quantity value, which means that it can be expressed as a number and a unit.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00340062> "quantity"@en)
EquivalentClasses(<https://openenergyplatform.org/ontology/oeo/OEO_00340062> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/BFO_0000019> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00140002> <https://openenergyplatform.org/ontology/oeo/OEO_00000350>)))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00340062> <http://purl.obolibrary.org/obo/BFO_0000019>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00340068> (size)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00340068> "Size is a quantity of an entity that quantifies its spatial extend.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00340068> "size"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00340068> <https://openenergyplatform.org/ontology/oeo/OEO_00340062>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00360017> (power system)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00360017> "A power system is an energy system covering the generation, transportation, distribution and consumption of electrical energy."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00360017> "power system"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00360017> <https://openenergyplatform.org/ontology/oeo/OEO_00030024>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00360018> (service product role)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00360018> "A service product role is the role of an immaterial entity that is the result of a service process, and whose value is determined by the value and the costs of the service."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00360018> "service product role"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00360018> <http://purl.obolibrary.org/obo/BFO_0000023>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00360019> (service product)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00360019> "A service product is an immaterial entity that has the service product role."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00360019> "service product"@en)
EquivalentClasses(<https://openenergyplatform.org/ontology/oeo/OEO_00360019> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/BFO_0000141> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <https://openenergyplatform.org/ontology/oeo/OEO_00360018>)))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00360019> <http://purl.obolibrary.org/obo/BFO_0000141>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00360020> (region of relevance)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00360020> "A region of relevance is a spatial region that is used in a study or analysis, or is part of spatial planning."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00360020> "region of relevance"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00360020> <http://purl.obolibrary.org/obo/BFO_0000006>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00360021> (study region role)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00360021> "A study region role is a role of a region of relevance that is under investigation and consists entirely of one or more subregions."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00360021> "study region role"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00360021> <http://purl.obolibrary.org/obo/BFO_0000023>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00360021> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <https://openenergyplatform.org/ontology/oeo/OEO_00360020>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00360022> (considered region role)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00360022> "A considered region role is the role of a region of relevance that is used in an analysis."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00360022> "considered region role"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00360022> <http://purl.obolibrary.org/obo/BFO_0000023>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00360022> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000052> <https://openenergyplatform.org/ontology/oeo/OEO_00360020>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00400013> (nature of model uncertainty)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00400013> "Nature of model uncertainty is a quality of a model that represents the core reason for uncertainty within it.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00400013> "nature of model uncertainty"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00400013> <http://purl.obolibrary.org/obo/BFO_0000019>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00400017> (level of model uncertainty)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00400017> "Level of model uncertainty is a quality of a model that represents the degree or severity of an uncertainty.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00400017> "level of model uncertainty"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00400017> <http://purl.obolibrary.org/obo/BFO_0000019>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00400022> (location of model uncertainty role)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00400022> "Location of model uncertainty role is a role of an entity in which a model uncertainty is located in.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00400022> "location of model uncertainty role"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00400022> <http://purl.obolibrary.org/obo/BFO_0000023>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00400043> (model uncertainty location)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00400043> "A model uncertainty location is a continuant that has the role to be a location of model uncertainty.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00400043> "model uncertainty location"@en)
EquivalentClasses(<https://openenergyplatform.org/ontology/oeo/OEO_00400043> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/BFO_0000002> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000087> <https://openenergyplatform.org/ontology/oeo/OEO_00400022>)))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00400043> <http://purl.obolibrary.org/obo/BFO_0000002>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00410009> (legislation)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00410009> "A legislation is a plan specification that is produced by a government and enables, prohibits or bans activities, or establishes rights or responsibilities."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00410009> "legislation"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00410009> <http://purl.obolibrary.org/obo/IAO_0000104>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00410009> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <https://openenergyplatform.org/ontology/oeo/OEO_00020093>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00410058> (voltage classification system)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00410058> "A voltage classification system is an information content entity that categorizes the voltages that components of an electricity grid power system usually operate on, into different levels."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00410058> "voltage classification system"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00410058> <http://purl.obolibrary.org/obo/IAO_0000030>)
