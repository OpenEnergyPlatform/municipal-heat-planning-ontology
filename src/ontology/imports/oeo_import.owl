SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140159> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000091> <https://openenergyplatform.org/ontology/oeo/OEO_00000097>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140167> (uncertainty approach)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140167> "An uncertainty approach is a model descriptor that specifies how a model deals with uncertainty.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140167> "uncertainty approach"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140167> <https://openenergyplatform.org/ontology/oeo/OEO_00020016>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00240003> (production)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00240003> "Production is the transformation process of combining various inputs in order to create an output that is a good."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00240003> "production"@en)
EquivalentClasses(<https://openenergyplatform.org/ontology/oeo/OEO_00240003> ObjectIntersectionOf(<https://openenergyplatform.org/ontology/oeo/OEO_00000419> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002234> <https://openenergyplatform.org/ontology/oeo/OEO_00010116>) ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00000533> <http://purl.obolibrary.org/obo/BFO_0000040>)))
