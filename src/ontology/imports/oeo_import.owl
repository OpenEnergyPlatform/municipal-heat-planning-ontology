AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00010083> "A market participant is an agent who participates in trading in a market exchange.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00010083> "market participant"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00010083> <https://openenergyplatform.org/ontology/oeo/OEO_00000051>)
