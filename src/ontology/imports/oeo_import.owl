SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00050001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <https://openenergyplatform.org/ontology/oeo/OEO_00000175>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00050001> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0002418> <https://openenergyplatform.org/ontology/oeo/OEO_00000147>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00050001> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00000500> <https://openenergyplatform.org/ontology/oeo/OEO_00000148>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00050018> (primary energy consumption value)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00050018> "A primary energy consumption value is an energy consumption value expressing the magnitude of the total consumption of energy in a spatial region excluding the non-energetic use of fuels."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00050018> "primary energy consumption value"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00050018> <https://openenergyplatform.org/ontology/oeo/OEO_00240019>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00050019> (energy value)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00050019> "An energy value is a quantity value that has an energy unit as unit."@en)
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00050019> "energy value"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00050019> <https://openenergyplatform.org/ontology/oeo/OEO_00000350>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00050019> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00040010> <http://purl.obolibrary.org/obo/UO_0000111>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00090001> (funder)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00090001> "A funder is a sponsor that supports by giving money.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00090001> "funder"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00090001> <https://openenergyplatform.org/ontology/oeo/OEO_00140009>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140003> (transport)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140003> "Transport is the process of moving people or goods from one place to another.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140003> "transport"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140003> <http://purl.obolibrary.org/obo/BFO_0000015>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140003> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> ObjectUnionOf(<https://openenergyplatform.org/ontology/oeo/OEO_00000323> <https://openenergyplatform.org/ontology/oeo/OEO_00010116>)))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140003> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00140002> <https://openenergyplatform.org/ontology/oeo/OEO_00320000>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140004> (international transport)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140004> "International transport is a transport process between different countries or within the same country via another country.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140004> "international transport"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140004> <https://openenergyplatform.org/ontology/oeo/OEO_00140003>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140009> (sponsor)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140009> "A sponsor is an agent that supports a person, organisation, or project by giving money, allowance of kind, services or other help.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140009> "sponsor"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140009> <https://openenergyplatform.org/ontology/oeo/OEO_00000051>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140033> (chemical reaction)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140033> "A chemical reaction is a transformation that involves the interconversion of chemical species.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140033> "chemical reaction"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140033> <https://openenergyplatform.org/ontology/oeo/OEO_00000419>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140033> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000057> <http://purl.obolibrary.org/obo/BFO_0000040>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140034> (redox reaction)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140034> "A redox reaction is a chemical reaction in which the oxidation of one reactant is coupled to the reduction of a second reactant.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140034> "redox reaction"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140034> <https://openenergyplatform.org/ontology/oeo/OEO_00140033>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140038> (combustion)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140038> "Combustion is an exothermic redox reaction between a fuel (the reductant) and an oxidant (usually atmospheric oxygen) which is initiated by a ignition source.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140038> "combustion"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140038> <https://openenergyplatform.org/ontology/oeo/OEO_00140034>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140039> (consumption)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140039> "Consumption is the process of using something and thereby reducing its amount.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140039> "consumption"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140039> <http://purl.obolibrary.org/obo/BFO_0000015>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140043> (time stamp)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140043> "A time stamp is a data descriptor that is used to describe either a temporal region or a data item that is related to a temporal region, e.g. a time stamped measurement datum. If the time stamp refers to a time step/one-dimensional temporal region, the indication of a time stamp alignment is required")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140043> "time stamp"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140043> <https://openenergyplatform.org/ontology/oeo/OEO_00000119>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140043> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000136> <http://purl.obolibrary.org/obo/BFO_0000008>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140043> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000136> <http://purl.obolibrary.org/obo/IAO_0000582>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140044> (time stamp alignment)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140044> "A time stamp alignment is a data descriptor that indicates the position of a time stamp in a time step.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140044> "time stamp alignment"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140044> <https://openenergyplatform.org/ontology/oeo/OEO_00000119>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140049> (energy conversion efficiency)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140049> "Energy conversion efficiency is a process attribute describing the ratio between the input of an energy transformation and the outputs that are used.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140049> "energy conversion efficiency"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140049> <https://openenergyplatform.org/ontology/oeo/OEO_00030019>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140049> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00000502> <https://openenergyplatform.org/ontology/oeo/OEO_00020003>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140049> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00140002> <https://openenergyplatform.org/ontology/oeo/OEO_00140050>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140050> (efficiency value)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140050> "An efficiency value is a quantity value stating the ratio between a process's inputs and the outputs that are used.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140050> "efficiency value"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140050> <https://openenergyplatform.org/ontology/oeo/OEO_00000350>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140050> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00040010> <http://purl.obolibrary.org/obo/UO_0010006>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140068> (aggregation type)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140068> "An aggregation type is a data descriptor that contains information on the aggregation method applied on a data set.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140068> "aggregation type"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140068> <https://openenergyplatform.org/ontology/oeo/OEO_00000119>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140068> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000136> <https://openenergyplatform.org/ontology/oeo/OEO_00020089>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140075> (primary energy carrier disposition)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140075> "Primary energy carrier disposition is an energy carrier disposition of material entities that are extracted directly from natural resources or that are natural energy flows.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140075> "primary energy carrier disposition"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140075> <https://openenergyplatform.org/ontology/oeo/OEO_00000151>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140076> (secondary energy carrier disposition)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140076> "Secondary energy carrier disposition is an energy carrier disposition of material entities that are manufactured from primary energy carriers or from a different form of secondary energy carriers.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140076> "secondary energy carrier disposition"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140076> <https://openenergyplatform.org/ontology/oeo/OEO_00000151>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140078> (primary energy carrier)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140078> "A primary energy carrier is an energy carrier that has the disposition primary energy carrier disposition.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140078> "primary energy carrier"@en)
EquivalentClasses(<https://openenergyplatform.org/ontology/oeo/OEO_00140078> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/BFO_0000040> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000091> <https://openenergyplatform.org/ontology/oeo/OEO_00140075>)))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140078> <https://openenergyplatform.org/ontology/oeo/OEO_00020039>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140079> (secondary energy carrier)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140079> "A secondary energy carrier is an energy carrier that has the secondary energy carrier disposition.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140079> "secondary energy carrier"@en)
EquivalentClasses(<https://openenergyplatform.org/ontology/oeo/OEO_00140079> ObjectIntersectionOf(<http://purl.obolibrary.org/obo/BFO_0000040> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/RO_0000091> <https://openenergyplatform.org/ontology/oeo/OEO_00140076>)))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140079> <https://openenergyplatform.org/ontology/oeo/OEO_00020039>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00140081> (emission rate)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00140081> "An emission rate is a process attribute that describes the output of an emission process.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00140081> "emission rate"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00140081> <https://openenergyplatform.org/ontology/oeo/OEO_00030019>)
