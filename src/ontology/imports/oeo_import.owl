AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00020072> "An analysis scope is an information content entity that describes the boundaries of what a study or scenario covers.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00020072> "analysis scope"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020072> <http://purl.obolibrary.org/obo/IAO_0000030>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020072> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000136> <https://openenergyplatform.org/ontology/oeo/OEO_00000367>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020072> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000136> <https://openenergyplatform.org/ontology/oeo/OEO_00020018>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020072> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000136> <https://openenergyplatform.org/ontology/oeo/OEO_00020032>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020072> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000136> <https://openenergyplatform.org/ontology/oeo/OEO_00020035>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020072> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000136> <https://openenergyplatform.org/ontology/oeo/OEO_00020097>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020072> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/IAO_0000136> <https://openenergyplatform.org/ontology/oeo/OEO_00020098>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00020086> (renewable energy carrier disposition)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00020086> "A renewable energy carrier disposition is an energy carrier disposition of an material entity that contains renewable energy.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00020086> "renewable energy carrier disposition"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020086> <https://openenergyplatform.org/ontology/oeo/OEO_00000151>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00020089> (typical period)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00020089> "A typical period is a time series that represents a couple of real time periods that have certain characteristics in common, e.g. seasonal specifications, weekly routines, etc. It doesn't refer to a real date. Typical periods are used to reduce computing time of energy system models.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00020089> "typical period"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020089> <https://openenergyplatform.org/ontology/oeo/OEO_00030034>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020089> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00000503> <https://openenergyplatform.org/ontology/oeo/OEO_00140068>))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00020093> (legal target description)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00020093> "A legal target description is an objective specification that contains statements about a desired future state of a system that a person or organisation commits to in a legally binding way.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00020093> "legal target description"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020093> <http://purl.obolibrary.org/obo/IAO_0000005>)

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00020097> (scenario year)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00020097> "A scenario year is a time step that has a duration of one year and is part of a scenario horizon.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00020097> "scenario year"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020097> <https://openenergyplatform.org/ontology/oeo/OEO_00030033>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020097> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000050> <https://openenergyplatform.org/ontology/oeo/OEO_00020098>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020097> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<https://openenergyplatform.org/ontology/oeo/OEO_00030035> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00040010> <http://purl.obolibrary.org/obo/UO_0000036>) DataHasValue(<https://openenergyplatform.org/ontology/oeo/OEO_00140178> "1"^^xsd:integer))))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00020098> (scenario horizon)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00020098> "A scenario horizon is a time step that is under investigation and consists entirely of one or more scenario years.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00020098> "scenario horizon"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020098> <https://openenergyplatform.org/ontology/oeo/OEO_00030033>)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020098> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> <https://openenergyplatform.org/ontology/oeo/OEO_00020097>))
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020098> ObjectSomeValuesFrom(<http://purl.obolibrary.org/obo/BFO_0000051> ObjectIntersectionOf(<https://openenergyplatform.org/ontology/oeo/OEO_00030035> ObjectSomeValuesFrom(<https://openenergyplatform.org/ontology/oeo/OEO_00040010> <http://purl.obolibrary.org/obo/UO_0000036>))))

# Class: <https://openenergyplatform.org/ontology/oeo/OEO_00020102> (energy transformation unit)

AnnotationAssertion(<http://purl.obolibrary.org/obo/IAO_0000115> <https://openenergyplatform.org/ontology/oeo/OEO_00020102> "An energy transformation unit is an artificial object that transforms, changes or transfers a certain type of energy.")
AnnotationAssertion(rdfs:label <https://openenergyplatform.org/ontology/oeo/OEO_00020102> "energy transformation unit"@en)
SubClassOf(<https://openenergyplatform.org/ontology/oeo/OEO_00020102> <https://openenergyplatform.org/ontology/oeo/OEO_00000061>)
