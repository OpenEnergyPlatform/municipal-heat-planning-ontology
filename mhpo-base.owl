pull request: https://github.com/OpenEnergyPlatform/municipal-heat-planning-ontology/pull/21</oeo:OEO_00020426>
        <www:ont00001754>Section 14  of the German Heat Planning Act (WPG)</www:ont00001754>
    </owl:ObjectProperty>
    


