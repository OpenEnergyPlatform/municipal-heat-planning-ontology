        <obo:IAO_0000115 xml:lang="en">A building stock is an object aggregate of buildings located in a spatial region.</obo:IAO_0000115>
        <obo:IAO_0000118 xml:lang="de">Anzahl Gebäude</obo:IAO_0000118>
        <obo:IAO_0000118 xml:lang="de">Gebäudebestand</obo:IAO_0000118>
