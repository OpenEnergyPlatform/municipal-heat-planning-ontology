     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:dcterms="http://purl.org/dc/terms/">
    <owl:Ontology rdf:about="https://purl.org/mhpo//mhpo-full.owl">
        <owl:versionIRI rdf:resource="https://purl.org/mhpo//releases/2026-09-29/mhpo-full.owl"/>
        <dcterms:creator>MHPO Developer Team &lt;https://github.com/OpenEnergyPlatform/municipal-heat-planning-ontology/blob/production/CITATION.cff&gt;</dcterms:creator>
        <dcterms:description>The municipal heat planning ontology (MHPO) is a domain reference ontology that covers the relevant terminology for the German &quot;Kommunale Wärmeplanung&quot;. Community heat planning in Germany is a structured process in which municipalities and cities plan their future heat supply based on energy demand, existing infrastructure, and climate protection goals. 
The aim is to reduce greenhouse gas emissions and heat consumption, increase the use of renewable energy, decrease dependence on fossil fuels and improve resilience of the system. The planning is typically carried out within the framework of climate protection programs and is supported by federal funding. The primary use case of MHPO is to describe data and metadata of the heat plans.</dcterms:description>
        <dcterms:license rdf:resource="http://creativecommons.org/publicdomain/zero/1.0/"/>
        <dcterms:license rdf:resource="https://opensource.org/license/mit"/>
        <dcterms:title>Municipal Heat Planning Ontology</dcterms:title>
        <rdfs:comment>Contact &lt;mirjam.stappel@uos.de&gt; or &lt;Ludwig.Huelk@rl-institut.de&gt;</rdfs:comment>
        <rdfs:comment>External documentation see &lt;https://openenergyplatform.github.io/municipal-heat-planning-ontology&gt; or &lt;https://purl.org/mhpo&gt;</rdfs:comment>
        <owl:versionInfo>to be added after first release</owl:versionInfo>
        <owl:versionInfo>2026-09-29</owl:versionInfo>
    </owl:Ontology>
    


