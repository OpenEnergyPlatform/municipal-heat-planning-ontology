    <!-- https://www.commoncoreontologies.org/ont00000004 -->

    <owl:Class rdf:about="https://www.commoncoreontologies.org/ont00000004">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000015"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000035"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000132"/>
                <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment>In CCO, the SubClassOf axioms are actually anonymous ancestors and inherited from process (BFO 2020).</rdfs:comment>
        <oeo:OEO_00020426>issue https://github.com/OpenEnergyPlatform/ontology/issues/2014
pull request: https://github.com/OpenEnergyPlatform/ontology/pull/2016</oeo:OEO_00020426>
    </owl:Class>
    


